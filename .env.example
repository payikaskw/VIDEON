# Neon PostgreSQL connection string (pooled connection recommended)
DATABASE_URL=

# Generate a long random secret (at least 32 characters)
ADMIN_JWT_SECRET=

# Admin credentials. Generate hash with: node scripts/hash-password.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Secure local-file upload worker
VIDEO_WORKER_URL=
UPLOAD_WORKER_SECRET=

# DoodStream API settings. Keep these server-side only.
DOODSTREAM_API_KEY=
DOODSTREAM_API_BASE_URL=https://doodapi.co/api

# Optional public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
