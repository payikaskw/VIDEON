# Neon PostgreSQL connection string (pooled connection recommended)
DATABASE_URL=

# Generate a long random secret (at least 32 characters)
ADMIN_JWT_SECRET=

# Admin credentials. Generate hash with: node scripts/hash-password.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Vidhold video hosting (server-side only)
VIDHOLD_API_KEY=

# Optional public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
