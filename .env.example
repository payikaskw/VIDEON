# Neon PostgreSQL connection string (pooled connection recommended)
DATABASE_URL=

# Generate a long random secret (at least 32 characters)
ADMIN_JWT_SECRET=

# Admin credentials. Generate hash with: node scripts/hash-password.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# DoodStream video hosting (server-side only; never expose to browser)
DOODSTREAM_API_KEY=

# Upload worker configuration
VIDEO_WORKER_URL=
UPLOAD_WORKER_SECRET=
APP_ORIGIN=https://viralindo.vercel.app

# Optional public site URL
NEXT_PUBLIC_SITE_URL=https://viralindo.vercel.app
